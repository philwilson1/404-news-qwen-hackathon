# --- Groq (free key: https://console.groq.com/keys) ---
GROQ_API_KEY=
# Groq retires models often. If one disappears, change these; no code change needed.
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=openai/gpt-oss-20b
GROQ_FALLBACK_MODELS=openai/gpt-oss-20b
GROQ_REASONING_EFFORT=low

# --- Supabase ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
PIPELINE_SECRET=

# --- Optional ---
# ALLOWED_ORIGINS=https://your-frontend.vercel.app
# NEWS_REGION=NG
# NEWS_LANG=en
# ARTICLES_PER_TOPIC=8
# MAX_TOPICS_PER_USER=10
